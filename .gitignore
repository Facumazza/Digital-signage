# ---- Secretos y configuración local ----
.env
.env.*
!.env.example
**/application-local.properties
**/application-local.yml
**/application-secret*.properties
*.pem
*.key
*.jks
*.keystore

# ---- Java / Maven / Gradle ----
target/
build/
.gradle/
*.class
*.jar

# Excepcion: el wrapper SI va al repo, es lo que permite compilar sin
# tener Gradle instalado. La negacion tiene que ir despues del *.jar:
# en gitignore gana la ultima regla que coincide.
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

