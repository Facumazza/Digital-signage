<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar: la carteleria no lleva barra de titulo. -->
    <style name="Tema.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">#939EAD</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#E6EAEF</item>
        <item name="android:textColorHint">#5A6470</item>
    </style>
</resources>
